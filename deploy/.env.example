# LANOT server secrets. Copy to $LANOT_DIR/.env and chmod 600. Never commit the real file.
# Values starting with CHANGE_ME count as unset.

# One token per agent host, ids as in lanot.toml. Generate each with: openssl rand -hex 32
AGENT_TOKENS=nas:CHANGE_ME,docker-host:CHANGE_ME,monitor:CHANGE_ME

# Optional: FritzBox user for read-only TR-064 queries (create a separate user on the box).
FRITZ_USER=lanot
FRITZ_PASSWORD=CHANGE_ME

# Optional: Anthropic API key for the investigator. Without it the investigator
# uses Ollama (if reachable) or stores the collected facts only.
ANTHROPIC_API_KEY=CHANGE_ME
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OLLAMA_MODEL=qwen2.5:7b

# Optional: dead man's switch. LANOT GETs this URL every minute, and URL/fail when
# its own alarm path is broken (healthchecks.io or anything with the same API).
HEALTHCHECK_URL=CHANGE_ME

# Push topic on the bundled ntfy server.
NTFY_TOPIC=lanot

# Optional: override the accepted Host headers for dashboard forms.
# ALLOWED_HOSTS=192.0.2.24:8080,monitor.lan:8080
